# Environment variables of the 832402226 calculator backend.
#
# Every value below has a sensible default, so the file is documentation rather
# than a requirement. Set the variables in your shell, or export them from your
# hosting provider's dashboard.

# Bind address. 0.0.0.0 lets phones on the same LAN reach the service.
CALC_HOST=0.0.0.0

# Listening port. On a cloud platform leave this unset: the platform injects
# PORT and the application picks it up automatically.
CALC_PORT=5000

# Debug mode. Useful locally, must stay false on a public deployment.
CALC_DEBUG=false

# SQLite file. Relative paths are resolved from the project root.
# CALC_DB_PATH=data/calculator.db

# Optional static front-end directory. When it contains an index.html, Flask
# serves the front-end from the same origin as the API (handy on hosts that
# expose a single port). Leave unset when the two projects run separately.
# CALC_FRONTEND_DIR=src/web

# Maximum length of an expression, in characters.
CALC_MAX_EXPRESSION_LENGTH=200

# Decimal precision (significant digits) used while evaluating.
CALC_DECIMAL_PRECISION=28

# Maximum number of decimal places in the formatted result.
CALC_MAX_DISPLAY_DP=10

# Absolute limit of a power exponent.
CALC_MAX_POWER_EXPONENT=1000

# Default page size of the history endpoint.
CALC_DEFAULT_PAGE_SIZE=20

# Allowed cross origin source; * means any origin.
CALC_CORS_ORIGIN=*
